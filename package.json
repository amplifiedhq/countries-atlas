{
  "name": "@amplifiedhq/countries-atlas",
  "version": "2.0.0",
  "description": "Uncover the world with a single lightweight library - countries, codes, currencies, flags, languages, cities, and more 🌎",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./states": {
      "types": "./dist/states.d.ts",
      "default": "./dist/states.js"
    },
    "./cities": {
      "types": "./dist/cities.d.ts",
      "default": "./dist/cities.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./flags/*": "./flags/*",
    "./translations": {
      "types": "./dist/translations.d.ts",
      "default": "./dist/translations.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate-data.mjs",
    "build": "rm -rf dist && npm run build:data && tsc -p tsconfig.build.json && npm run build:flags && node scripts/finalize-dist.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "preversion": "npm run lint && npm run test",
    "build:flags": "node scripts/build-flags.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amplifiedhq/countries-atlas.git"
  },
  "contributors": [
    {
      "name": "Josiah Endurance",
      "email": "hendurhance.dev@gmail.com"
    },
    {
      "name": "Abdulrazaq Adewale",
      "email": "classyrazy014@gmail.com"
    }
  ],
  "keywords": [
    "internationalization",
    "i18n",
    "countries",
    "country",
    "country-codes",
    "geography",
    "states",
    "provinces",
    "cities",
    "continents",
    "flags",
    "languages",
    "currencies",
    "timezones",
    "countries-atlas"
  ],
  "author": "AmplifiedHQ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amplifiedhq/countries-atlas/issues"
  },
  "homepage": "https://github.com/amplifiedhq/countries-atlas#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "svgo": "^3.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "flags"
  ],
  "typesVersions": {
    "*": {
      "states": [
        "./dist/states.d.ts"
      ],
      "cities": [
        "./dist/cities.d.ts"
      ],
      "flags": [
        "./dist/flags.d.ts"
      ],
      "translations": [
        "./dist/translations.d.ts"
      ]
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19",
      "onFail": "warn"
    }
  }
}
